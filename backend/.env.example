# TUFF backend settings. Copy to backend/.env. All values are optional.

# --- Server ---------------------------------------------------------------
TUFF_ENVIRONMENT=development
TUFF_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
TUFF_LOG_LEVEL=INFO

# --- Storage --------------------------------------------------------------
# Default: SQLite file at backend/data/tuff.db. Any SQLAlchemy async URL works.
# TUFF_DATABASE_URL=sqlite+aiosqlite:///./data/tuff.db
# Set false in production and run `uv run alembic upgrade head` instead.
TUFF_AUTO_CREATE_TABLES=true

# --- Product search -----------------------------------------------------
TUFF_SEARCH_TIMEOUT_SECONDS=12
TUFF_SEARCH_CACHE_TTL_SECONDS=1800
# Headless browser fallback (Playwright). Point at a system Chromium, or run
# `uv run playwright install chromium` and leave this unset.
# TUFF_BROWSER_EXECUTABLE=/usr/bin/chromium
TUFF_BROWSER_FALLBACK=true
# 12 extra stores via Selenium (slow). Needs: uv sync --extra legacy-scrapers
TUFF_LEGACY_SCRAPERS=false

# --- Rate limits (requests/minute per IP) -------------------------------------
TUFF_RATE_LIMIT_SEARCH=30
TUFF_RATE_LIMIT_ANALYSIS=10
TUFF_RATE_LIMIT_STYLIST=20

# --- Stylist ------------------------------------------------------------------
# Without a key the stylist runs in rule-based concierge mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
