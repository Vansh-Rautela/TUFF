# TUFF Fashion - India API Configuration
# All APIs support INR (₹) pricing
# Copy this file to .env and fill in your API keys

# ============================================================================
# RAPIDAPI - Myntra & Flipkart (RECOMMENDED FOR INDIA) ⭐
# ============================================================================
# Sign up at: https://rapidapi.com/ (FREE account)
# Subscribe to both:
#   - Myntra API: https://rapidapi.com/apidojo/api/myntra16
#   - Flipkart API: https://rapidapi.com/apidojo/api/flipkart-flipkart
# 
# FREE TIER: 500 requests/month per API
# PAID TIER: ₹750/month per API for unlimited requests
# 
# After subscribing, get your key from: https://rapidapi.com/developer/apps
RAPIDAPI_KEY=your_rapidapi_key_here


# ============================================================================
# SERPAPI - Google Shopping India (OPTIONAL - Covers ALL sites)
# ============================================================================
# Sign up at: https://serpapi.com/ (FREE account)
# FREE TIER: 100 searches/month
# PAID TIER: ₹3,000/month for 5,000 searches
# 
# Best for: Getting products from ALL Indian e-commerce sites
#           (Myntra, Flipkart, Amazon, Ajio, Nykaa, Meesho, etc.)
# SERPAPI_KEY=your_serpapi_key_here


# ============================================================================
# Amazon India Product Advertising API (OPTIONAL)
# ============================================================================
# Apply at: https://affiliate.amazon.in/
# 
# Requirements:
#   1. Sign up as Amazon Associate (India)
#   2. Get approved (need 3 sales within 180 days)
#   3. Apply for Product Advertising API access
# 
# COST: Completely FREE (unlimited API calls)
# BENEFIT: Also earn 1-10% affiliate commission on sales!
# 
# AMAZON_IN_ACCESS_KEY=your_amazon_india_access_key
# AMAZON_IN_SECRET_KEY=your_amazon_india_secret_key
# AMAZON_IN_PARTNER_TAG=your_amazon_india_partner_tag


# ============================================================================
# APIFY - Web Scraping as a Service (OPTIONAL)
# ============================================================================
# Sign up at: https://apify.com/
# FREE TIER: $5 credit/month (~500-1000 scrapes)
# 
# More reliable than manual web scraping
# Has pre-built scrapers for Myntra, Flipkart, Amazon India
# APIFY_TOKEN=your_apify_token_here


# ============================================================================
# Flask Configuration
# ============================================================================
FLASK_ENV=development
DEBUG=True


# ============================================================================
# QUICK START RECOMMENDATION
# ============================================================================
# 
# Phase 1 (Start here - Cost: ₹0):
#   ✓ Sign up for RapidAPI
#   ✓ Subscribe to Myntra API (500 free/month)
#   ✓ Add your RAPIDAPI_KEY above
#   ✓ Run: python test_india_apis.py
# 
# Phase 2 (Optional - Cost: ₹0):
#   ✓ Subscribe to Flipkart API on RapidAPI (500 free/month)
#   ✓ Now you have 1,000 free API calls/month!
# 
# Phase 3 (Optional - Cost: ₹0):
#   ✓ Sign up for SerpApi (100 free/month)
#   ✓ Adds coverage for ALL Indian e-commerce sites
# 
