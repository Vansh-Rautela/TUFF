# TUFF backend configuration. Copy to Backend/.env and fill in what you need.
# Never commit Backend/.env. All values below are placeholders.

# --- AI stylist (TUFFY) - optional --------------------------------------
# Without a key the app works; /tuffy/chat returns 503 with a friendly message.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30

# --- Server ---------------------------------------------------------------
TUFF_HOST=127.0.0.1
TUFF_PORT=5000
# Never enable debug on a machine reachable by others (Werkzeug debugger = remote code execution).
TUFF_DEBUG=false
# Comma-separated origins allowed to call the API (the Vite dev server by default).
TUFF_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Storage --------------------------------------------------------------
# Folder for per-user JSON profiles, relative to Backend/.
TUFF_DATA_DIR=user_data
# Max request size in bytes (photos are sent base64-encoded).
TUFF_MAX_REQUEST_BYTES=12582912

# --- Product search (headless Chrome scrapers) -----------------------------
TUFF_SCRAPER_WORKERS=3
TUFF_SCRAPER_TIMEOUT_SECONDS=90
TUFF_SCRAPE_CACHE_TTL_SECONDS=900
TUFF_PAGE_LOAD_TIMEOUT=30
# Set these if Selenium cannot find Chrome/Chromium on its own, e.g. on Linux:
# CHROME_BINARY=/usr/bin/chromium
# CHROMEDRIVER_PATH=/usr/bin/chromedriver

# --- Unused retail API integrations ------------------------------------------
# api_integrations*.py / hybrid_fetcher.py are not wired into main.py yet.
# These keys are only read by those modules and their manual test scripts.
# RAPIDAPI_KEY=
# SERPAPI_KEY=
# APIFY_TOKEN=
# AMAZON_IN_ACCESS_KEY=
# AMAZON_IN_SECRET_KEY=
# AMAZON_IN_PARTNER_TAG=
